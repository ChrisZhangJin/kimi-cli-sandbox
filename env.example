# ===== Required: Kimi API Key =====
# Get your API key from: https://www.kimi.com/code/console
KIMI_API_KEY=your_kimi_api_key_here

# ===== Required: Default Model =====
# Options: kimi-k2-turbo, kimi-k2-thinking-turbo, etc.
# See: https://platform.moonshot.cn/docs/intro
KIMI_MODEL_NAME=kimi-k2-turbo

# ===== Optional: Proxy Settings (if behind firewall) =====
# Format: http://host:port or http://user:pass@host:port
# On macOS/Windows Docker Desktop, use host.docker.internal instead of 127.0.0.1
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# ===== Optional: Base URL (usually not needed) =====
# KIMI_BASE_URL=https://api.moonshot.cn/v1
